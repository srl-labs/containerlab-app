{
  "name": "@srl-labs/containerlab-app-server",
  "version": "0.3.0",
  "private": true,
  "description": "Shared Fastify BFF for Containerlab web and desktop hosts.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/static": "catalog:",
    "@fastify/websocket": "catalog:",
    "@containerlab/clab-ui": "workspace:*",
    "@srl-labs/containerlab-app-contract": "workspace:*",
    "fastify": "catalog:",
    "ws": "catalog:",
    "undici": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --import tsx --test 'src/**/*.test.ts'",
    "lint": "oxlint --type-aware --import-plugin --react-plugin --jsx-a11y-plugin src"
  }
}
