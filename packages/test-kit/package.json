{
  "name": "@srl-labs/containerlab-test-kit",
  "version": "0.3.0",
  "private": true,
  "description": "Shared host contract suites and browser test conventions for Containerlab apps.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./contracts": "./src/contracts/index.ts",
    "./playwright": "./src/playwright/index.ts"
  },
  "dependencies": {
    "@containerlab/clab-ui": "workspace:*",
    "@playwright/test": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --import tsx --test 'src/**/*.test.ts'",
    "lint": "oxlint --type-aware --import-plugin src"
  }
}
