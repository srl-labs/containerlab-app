{
  "name": "@srl-labs/containerlab-standalone-runtime",
  "version": "0.3.0",
  "private": true,
  "description": "Shared standalone Containerlab renderer/runtime for web and desktop hosts.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./terminal-main": "./src/terminalMain.tsx",
    "./web-main": "./src/main.tsx",
    "./wireshark-vnc-main": "./src/wiresharkVncMain.tsx",
    "./backend": "./src/backend.ts",
    "./host": "./src/standaloneHostShared.ts",
    "./endpoints": "./src/stores/endpointStore.ts"
  },
  "dependencies": {
    "@containerlab/clab-ui": "workspace:*",
    "@srl-labs/containerlab-app-contract": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "tsx": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --import tsx --test 'src/**/*.test.ts'",
    "lint": "oxlint --type-aware --import-plugin --react-plugin --jsx-a11y-plugin src"
  }
}
