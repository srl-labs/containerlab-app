{
  "name": "containerlab-app-web",
  "version": "0.3.0",
  "private": true,
  "description": "Browser host for containerlab-app built on @containerlab/clab-ui.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development concurrently -k -n server,vite \"tsx watch server/index.ts\" \"sh -c 'node ../../scripts/wait-web-server.mjs && vite --config vite.config.ts'\"",
    "dev:local": "pnpm run dev",
    "dev:pages": "NODE_ENV=development VITE_CLAB_RUNTIME_MODE=pages vite --config vite.config.ts",
    "dev:pages:local": "pnpm run dev:pages",
    "build": "vite build --config vite.config.ts && pnpm run build:server",
    "build:pages": "VITE_CLAB_RUNTIME_MODE=pages vite build --config vite.config.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/server/index.cjs --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "typecheck:local-ui": "pnpm run typecheck",
    "lint": "pnpm run typecheck && pnpm run lint:ts",
    "lint:ts": "oxlint --type-aware --import-plugin --react-plugin --jsx-a11y-plugin .",
    "lint:ts:fix": "oxlint --import-plugin --react-plugin --jsx-a11y-plugin . --fix --fix-suggestions",
    "test:e2e": "playwright test --config test/e2e/playwright.config.ts",
    "test:base-path": "pnpm run build && VITE_CLAB_RUNTIME_MODE=pages vite build --config vite.config.ts --outDir dist/pages && playwright test --config test/e2e/playwright.base-path.config.ts",
    "test:e2e:local-ui": "pnpm run test:e2e",
    "test:e2e:smoke": "playwright test --config test/e2e/playwright.config.ts test/e2e/specs/standalone-smoke.spec.ts --project=chromium",
    "test:e2e:smoke:local-ui": "pnpm run test:e2e:smoke",
    "test:e2e:ui": "playwright test --config test/e2e/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config test/e2e/playwright.config.ts --debug",
    "start": "NODE_ENV=production node dist/server/index.cjs",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@mui/material": "catalog:",
    "@srl-labs/containerlab-app-server": "workspace:*",
    "@srl-labs/containerlab-standalone-runtime": "workspace:*",
    "@xterm/addon-fit": "catalog:",
    "@xterm/xterm": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "catalog:",
    "yaml": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "autoprefixer": "catalog:",
    "concurrently": "catalog:",
    "esbuild": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "postcss": "catalog:",
    "postcss-import": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
